# Ejercicio 1: Producto escalar de dos vectores
v1 = (1, 2, 3)
v2 = (-1, 0, 2)

producto_escalar = v1[0]*v2[0] + v1[1]*v2[1] + v1[2]*v2[2]
print("Producto escalar:", producto_escalar)

